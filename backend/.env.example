PORT=4000
# MongoDB URI (local or Atlas)
MONGO_URI=mongodb://localhost:27017/highway_ai
# Optional Redis cache (falls back to memory if absent)
# REDIS_URL=redis://localhost:6379

# Camera node API key
API_KEY=highway-secret-key
CLIENT_ORIGIN=http://localhost:3000

# Payment Provider: mock | payhere (default is mock)
PAYMENT_PROVIDER=mock
PAYHERE_MERCHANT_ID=1211111
PAYHERE_MERCHANT_SECRET=4XXXXXXXXXXXXXX
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Mailgun Email Receipts & Failure Alerts
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxxxxxxxxxx
MAILGUN_DOMAIN=sandboxxxxxxxxxxx.mailgun.org
MAILGUN_FROM=HighWay AI <postmaster@sandboxxxxxxxxxxx.mailgun.org>
ADMIN_EMAIL=admin@highway.lk
# Optional Mailgun EU endpoint: https://api.eu.mailgun.net/v3
MAILGUN_BASE_URL=https://api.mailgun.net/v3

# Authentication JWT Secret
JWT_SECRET=highway-ai-jwt-super-secret-key-2026
